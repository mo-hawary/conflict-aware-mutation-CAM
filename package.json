{
  "name": "conflict-aware-mutation",
  "shortName": "cam",
  "version": "0.2.2",
  "description": "Resolve stale CRUD writes with safe three-way merges.",
  "author": {
    "name": "Mo Hawary",
    "email": "dev.elhawary@gmail.com",
    "url": "https://www.linkedin.com/in/mohawary/"
  },
  "homepage": "https://github.com/mo-hawary/conflict-aware-mutation-CAM#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "import": "./dist/recovery/index.js",
      "default": "./dist/recovery/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run typecheck:tests && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run package:verify",
    "package:verify": "node scripts/verify-package.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**' --test-coverage-exclude='dist/recovery/**' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 test/*.test.mjs && node --test --experimental-test-coverage --test-coverage-include='dist/recovery/**' --test-coverage-lines=93 --test-coverage-branches=90 --test-coverage-functions=100 test/recovery.test.mjs",
    "lint:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "size": "npm run build && size-limit",
    "examples": "npm run build && node examples/fetch-rest.mjs && node examples/versioned-rest-recovery.mjs && node examples/collections-and-rules.mjs",
    "bench": "npm run build && node --expose-gc bench/merge.bench.mjs",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.1.0",
    "@stryker-mutator/core": "10.0.0",
    "fast-check": "4.10.2",
    "publint": "0.3.24",
    "size-limit": "14.1.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo-hawary/conflict-aware-mutation-CAM.git"
  },
  "bugs": {
    "url": "https://github.com/mo-hawary/conflict-aware-mutation-CAM/issues"
  },
  "keywords": [
    "conflict-resolution",
    "optimistic-concurrency",
    "three-way-merge",
    "stale-write",
    "json-merge",
    "etag",
    "crud",
    "typescript",
    "headless"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
