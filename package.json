{
  "name": "conflict-aware-mutation",
  "shortName": "cam",
  "version": "0.1.2",
  "description": "Resolve stale CRUD writes with safe three-way merges.",
  "author": {
    "name": "Mo Hawary",
    "email": "dev.elhawary@gmail.com",
    "url": "https://www.linkedin.com/in/mohawary/"
  },
  "homepage": "https://github.com/mo-hawary/conflict-aware-mutation-CAM#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run typecheck:tests && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run package:verify",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo-hawary/conflict-aware-mutation-CAM.git"
  },
  "bugs": {
    "url": "https://github.com/mo-hawary/conflict-aware-mutation-CAM/issues"
  },
  "keywords": [
    "conflict-resolution",
    "optimistic-concurrency",
    "three-way-merge",
    "crud",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
